#!/usr/bin/env bash
set -euo pipefail

echo "[resume] Checking Rust toolchain"

if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "[resume] Cargo is unavailable; rerun .agents/setup" >&2
  exit 1
fi

cargo --version
echo "[resume] Ready"
